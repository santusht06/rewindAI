# Rewind Environment Configuration Example
# Copy to .env for local development. Never commit .env or real credentials.

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security & Secrets (Must be overridden in production)
SECRET_KEY=change-this-in-production-placeholder-secret-key-32chars

# Database Connection (PostgreSQL + pgvector for production; SQLite for local test runs)
DATABASE_URL=sqlite+aiosqlite:///./rewind_local.db

# Optional AI Provider API Keys
# When unset, system defaults to deterministic Mock / Evaluation Provider
GEMINI_API_KEY=
OPENAI_API_KEY=

# Spoiler & RAG Guardrails
SPOILER_DEFAULT_MODE=safe
MAX_CONTEXT_TOKENS=4000
MAX_QUESTION_LENGTH=500
CONFIRMATION_NONCE_EXPIRE_SECONDS=300
