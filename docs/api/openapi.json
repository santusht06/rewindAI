  "components": {
    "schemas": {
      "CitationSchema": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "start_time_seconds": {
            "type": "integer",
            "title": "Start Time Seconds"
          },
          "end_time_seconds": {
            "type": "integer",
            "title": "End Time Seconds"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "relevance_score": {
            "type": "number",
            "title": "Relevance Score",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "start_time_seconds",
          "end_time_seconds",
          "text"
        ],
        "title": "CitationSchema",
        "description": "Viewer-safe evidence reference grounded in subtitle chunks."
      },
      "CreateSessionRequest": {
        "properties": {
          "title_id": {
            "type": "string",
            "title": "Title Id",
            "description": "ID of the movie title to view"
          },
          "locale": {
            "type": "string",
            "maxLength": 10,
            "title": "Locale",
            "default": "en"
          },
          "position_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Position Seconds",
            "description": "Initial playback offset",
            "default": 0
          },
          "source": {
            "$ref": "#/components/schemas/ProgressSource",
            "default": "manual_slider"
          }
        },
        "type": "object",
        "required": [
          "title_id"
        ],
        "title": "CreateSessionRequest",
        "description": "Request to create an active viewing session."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionRequest": {
        "properties": {
          "raw_content": {
            "type": "string",
            "minLength": 10,
            "title": "Raw Content",
            "description": "Raw SRT or WebVTT subtitle text"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type",
            "description": "Asset source format (srt, vtt)",
            "default": "srt"
          },
          "auto_publish": {
            "type": "boolean",
            "title": "Auto Publish",
            "description": "Whether to atomically publish upon completion",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "raw_content"
        ],
        "title": "IngestionRequest",
        "description": "Payload for authorized asset ingestion."
      },
      "IngestionResponse": {
        "properties": {
          "movie_id": {
            "type": "string",
            "title": "Movie Id"
          },
          "content_version_id": {
            "type": "string",
            "title": "Content Version Id"
          },
          "version_number": {
            "type": "integer",
            "title": "Version Number"
          },
          "source_checksum": {
            "type": "string",
            "title": "Source Checksum"
          },
          "cue_count": {
            "type": "integer",
            "title": "Cue Count"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "processing_status": {
            "type": "string",
            "title": "Processing Status"
          },
          "elapsed_milliseconds": {
            "type": "number",
            "title": "Elapsed Milliseconds"
          }
        },
        "type": "object",
        "required": [
          "movie_id",
          "content_version_id",
          "version_number",
          "source_checksum",
          "cue_count",
          "chunk_count",
          "duration_seconds",
          "is_active",
          "processing_status",
          "elapsed_milliseconds"
        ],
        "title": "IngestionResponse",
        "description": "Response returned upon successful asset processing and staging."
      },
      "MovieStatus": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "unlisted"
        ],
        "title": "MovieStatus"
      },
      "ProgressResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "current_position_seconds": {
            "type": "integer",
            "title": "Current Position Seconds"
          },
          "progress_source": {
            "$ref": "#/components/schemas/ProgressSource"
          },
          "is_verified": {
            "type": "boolean",
            "title": "Is Verified"
          },
          "spoiler_mode": {
            "$ref": "#/components/schemas/SpoilerMode"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "current_position_seconds",
          "progress_source",
          "is_verified",
          "spoiler_mode",
          "updated_at"
        ],
        "title": "ProgressResponse",
        "description": "Response containing validated and normalized progress."
      },
      "ProgressSource": {
        "type": "string",
        "enum": [
          "verified_integration",
          "manual",
          "manual_slider",
          "voice_cue",
          "partner_sync",
          "unknown"
        ],
        "title": "ProgressSource"
      },
      "QuestionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Question",
            "description": "User question about the story"
          },
          "client_request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Request Id"
          },
          "locale": {
            "type": "string",
            "maxLength": 10,
            "title": "Locale",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QuestionRequest",
        "description": "Question submission request.\n\nInvariants:\n- Client CANNOT specify spoiler policy bypass.\n- Question length is strictly bounded (max 500 chars)."
