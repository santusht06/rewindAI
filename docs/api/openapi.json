    "/api/v1/sessions/{session_id}/questions": {
      "post": {
        "tags": [
          "questions"
        ],
        "summary": "Ask Question",
        "description": "Submit a question within a viewing session.\n\nEnforces strict server-side boundary:\n1. Validates session existence and viewer identity.\n2. Validates question length and content.\n3. Respects server-controlled spoiler mode and current playback position.\n4. Future chunks (end_time_seconds > current_position_seconds) are filtered out pre-LLM in SAFE mode.",
        "operationId": "ask_question_api_v1_sessions__session_id__questions_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "x-user-id",
